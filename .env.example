# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# NOTE: DJANGO_SETTINGS_MODULE is deliberately NOT set here. It cannot work from .env --
# manage.py and config/wsgi.py resolve it with os.environ.setdefault() before Django imports
# settings, and load_dotenv() runs inside settings.py, i.e. after that decision is made.
# Setting it here is silently ignored. Export it in the environment if you must override it.

# development | production (default). development turns DEBUG on and tolerates the
# placeholder SECRET_KEY; anything else refuses to start without a real one.
APP_ENV=development
ALLOWED_HOSTS=*
# LOG_LEVEL=INFO

# MUST be byte-identical to the Flask app's SECRET_KEY (and minty-payment-request-api's).
#
# Flask MINTS the onboarding JWT; this service only verifies it. A mismatch is not a
# loud failure at boot -- it is a 401 on every single request, which reads to a user
# as "my session expired" and sends them round a login loop. If Group A returns 401
# with a token Flask just issued, check this before anything else.
SECRET_KEY=replace-me-shared-with-flask

# ---------------------------------------------------------------------------
# Database -- the same database and schema the Flask app owns
#
# This service pins search_path to the ?schema= on the URL (default pettycashv3) and
# treats every table as read-mostly and Alembic-owned. It ships no migrations. Do not
# point it at a database Flask has not migrated. Percent-encode special characters in the
# password; other query parameters (sslmode=require, ...) are passed to the driver.
# ---------------------------------------------------------------------------
# The schema, kept as its own line and filled into the URL below (pettycashv3 - the
# permanent name). Hosting dashboards don't expand ${...}: there, write the name into the URL.
DB_SCHEMA=pettycashv3
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/postgres?schema=${DB_SCHEMA}

# ---------------------------------------------------------------------------
# Origins
# ---------------------------------------------------------------------------
# Where the onboarding wizard (minty-onboarding-web) is served from. Also the CORS default.
ONBOARDING_WEB_URL=http://localhost:3030
# Optional override, comma-separated, if more than one origin needs in.
# CORS_ALLOWED_ORIGINS=http://localhost:3030

# ---------------------------------------------------------------------------
# Cross-module: the Flask app (Petty Cash)
#
# Groups F and G proxy here -- module grants, Stripe, and anything needing a Xero
# token. See core/minty_client.py. The Xero token service is derived from it
# (PETTY_CASH_URL + /api/internal/xero/token), which vends live Xero access tokens and
# must not be routable from the public internet.
# ---------------------------------------------------------------------------
PETTY_CASH_URL=http://localhost:8010

# ---------------------------------------------------------------------------
# Cross-module: the subscription API (minty-subscription-api)
#
# Group G proxies here -- cards, billing accounts, billing consent, and finalize's
# trial start. See core/subscription_client.py.
# ---------------------------------------------------------------------------
SUBSCRIPTION_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Display timezone
#
# GET /api/onboarding/server-time answers "what is today" so the wizard's date picker
# caps at the user's local midnight. Must agree with Minty, which hardcodes this.
# ---------------------------------------------------------------------------
DISPLAY_TIMEZONE=Asia/Hong_Kong

# ---------------------------------------------------------------------------
# Deliberately absent: STRIPE_* and XERO_*.
#
# Adding either to this service is a bug, not a feature. Xero invalidates a refresh
# token on every use, so a second refresher bricks the customer's connection; Stripe
# state lives in local tables that Flask's checkout logic treats as source of truth,
# so a second writer there charges twice. Flask owns both rails. Anything this service
# needs from them, it asks Flask for.
# ---------------------------------------------------------------------------
