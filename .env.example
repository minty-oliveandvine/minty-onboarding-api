# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings
DEBUG=True
ALLOWED_HOSTS=*
LOG_LEVEL=INFO

# MUST be byte-identical to the Flask app's SECRET_KEY (and billing-backend's).
#
# Flask MINTS the onboarding JWT; this service only verifies it. A mismatch is not a
# loud failure at boot -- it is a 401 on every single request, which reads to a user
# as "my session expired" and sends them round a login loop. If Group A returns 401
# with a token Flask just issued, check this before anything else.
SECRET_KEY=replace-me-shared-with-flask

# ---------------------------------------------------------------------------
# Database -- the same database and schema the Flask app owns
#
# This service pins search_path to pettycashv2 and treats every table as read-mostly
# and Alembic-owned. It ships no migrations. Do not point it at a database Flask has
# not migrated.
# ---------------------------------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------------------------
# Origins
# ---------------------------------------------------------------------------
# Where the onboarding wizard is served from. Also the CORS default.
ONBOARDING_APP_URL=http://localhost:3001
# Comma-separated, if more than one origin needs in.
# CORS_ALLOWED_ORIGINS=http://localhost:3001

# ---------------------------------------------------------------------------
# Cross-module: the Flask app
#
# Groups F and G proxy here -- module grants, Stripe, and anything needing a Xero
# token. See core/minty_client.py.
# ---------------------------------------------------------------------------
FLASK_APP_URL=http://localhost:5001
MINTY_PROXY_TIMEOUT=20

# ---------------------------------------------------------------------------
# Display timezone
#
# GET /api/onboarding/server-time answers "what is today" so the wizard's date picker
# caps at the user's local midnight. Must agree with Minty, which hardcodes this.
# ---------------------------------------------------------------------------
DISPLAY_TIMEZONE=Asia/Hong_Kong

# ---------------------------------------------------------------------------
# Deliberately absent: STRIPE_* and XERO_*.
#
# Adding either to this service is a bug, not a feature. Xero invalidates a refresh
# token on every use, so a second refresher bricks the customer's connection; Stripe
# state lives in local tables that Flask's checkout logic treats as source of truth,
# so a second writer there charges twice. Flask owns both rails. Anything this service
# needs from them, it asks Flask for.
# ---------------------------------------------------------------------------
